    {
      "persona": "Garota",
      "gender": null,
      "text": "CERTO... VOU FAZER O QUE VOCÊ MANDAR, ENTÃO PARA...",
      "cena": ""
    },
    {
      "persona": "Rapaz",
      "gender": null,
      "text": "ENTÃO ANDA LOGO. DEITA NA CAMA, COLOQUE SUAS MÃOS NA CABEÇA E ABRA AS PERNAS.",
      "cena": ""
    },
    {
      "persona": "Narrador",
      "gender": "F",
      "text": "Diante de sua superioridade, a submissão dela torna-se completa.",
      "cena": ""
    },
    {
      "persona": "Narrador",
      "gender": "F",
      "text": "A cena de humilhação se desenrola enquanto ela perde as forças.",
      "cena": ""
    },
    {
      "persona": "Garota",
      "gender": null,
      "text": "M-ME DESCULPE, GUERREIRO. POR FAVOR ME PERDOE... GENOA DA CASA DARIUS...",
      "cena": ""
    },
    {
      "persona": "Rapaz",
      "gender": null,
      "text": "ESSE MC SABE COMO SE VINGAR. A FILHA DA GRANDE FAMÍLIA DARIUS ESTÁ ABRINDO AS PERNAS PRA MIM...",
      "cena": ""
    },
    {
      "persona": "Narrador",
      "gender": "F",
      "text": "A vingança do guerreiro atinge, então, seu ápice absoluto.",
      "cena": ""
    },
    {
      "persona": "Rapaz",
      "gender": null,
      "text": "É UM DESPERDÍCIO VER ESSA VISÃO E NÃO FAZER NA DA. COM SEUS",
      "cena": ""
    },
    {
      "persona": "Rapaz",
      "gender": null,
      "text": "MAMILOS DUROS TAMBÉM. E-ESPERA! HNGH!",
      "cena": ""
    },
    {
      "persona": "Rapaz",
      "gender": null,
      "text": "VOCÊ QUER MESMO QUE EU PARE, GENOA? SEJA HONESTA CONSIGO MESMA.",
      "cena": ""
    },
    {
      "persona": "Garota",
      "gender": null,
      "text": "HA...",
      "cena": ""
    },
    {
      "persona": "Rapaz",
      "gender": null,
      "text": "VOCÊ ESTÁ DIZENDO NÃO, MAS O SEU CORPO ESTÁ FALANDO O CONTRÁRIO. Hizh..!",
      "cena": ""
    },
    {
      "persona": "Rapaz",
      "gender": null,
      "text": "O QUE VOCÊ REALMENTE QUER AGORA?",
