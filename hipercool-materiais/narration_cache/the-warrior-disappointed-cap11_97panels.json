      "cena": ""
    },
    {
      "persona": "Narrador",
      "gender": "F",
      "text": "Sob tamanha força, a resistência da garota finalmente começa a ceder.",
      "cena": ""
    },
    {
      "persona": "Rapaz",
      "gender": null,
      "text": "ADMITA LOGO. VOCÊ É UMA PUTA PERVERTIDA FICANDO COM TESÃO POR CAUSA DA DOR.",
