    },
    {
      "persona": "Garota",
      "gender": null,
      "text": "E-EU ADMITO ENTÃO PARA!",
      "cena": ""
    },
    {
      "persona": "Garota",
      "gender": null,
      "text": "N-NÃO CONSIGO MAIS AGUENTAR!",
      "cena": ""
    },
    {
      "persona": "Narrador",
      "gender": "F",
      "text": "Enquanto isso, o guerreiro mantém o controle total da situação.",
      "cena": ""
    },
    {
      "persona": "Rapaz",
      "gender": null,
      "text": "É MESMO? VOCÊ SE ARREPENDE DE TER MENTIDO? S-SIM! ENTÃO POR FAVOR...",
      "cena": ""
    },
    {
      "persona": "Rapaz",
      "gender": null,
      "text": "VOCÊ PODIA ABRIR MAIS AS PERNAS PARA SE DESCULPAR",
