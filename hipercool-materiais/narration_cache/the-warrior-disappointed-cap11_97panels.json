      "cena": ""
    },
    {
      "persona": "Narrador",
      "gender": "F",
      "text": "A dominação exercida por ele é, agora, absoluta e inquestionável.",
      "cena": ""
    },
    {
      "persona": "Rapaz",
      "gender": null,
