    "jsCode": "const input = $input.first().json;\nconst pageId = input.query ? input.query.id : \"\";\nconst staticData = $getWorkflowStaticData(\"global\");\nconst pages = staticData.pages || {};\n\nif (pageId && pages[pageId]) {\n  return [{ json: { html: pages[pageId].html } }];\n}\n\nconst errorPage = \"<\" + \"!DOCTYPE html><html><head><meta charset=UTF-8><title>404</title>\" +\n  \"<style>body{font-family:system-ui;background:#07111f;color:#f4f7fb;display:flex;align-items:center;justify-content:center;min-height:100vh;text-align:center}\" +\n  \"h1{font-size:72px;color:#7c3aed}p{color:#91a4b8;margin:16px 0}a{color:#7c3aed}</style></head>\" +\n  \"<body><div><h1>404</h1><p>Landing page nao encontrada.</p>\" +\n  \"<a href=/webhook/landing-page>Criar nova</a></div></body></html>\";\nreturn [{ json: { html: errorPage } }];"
