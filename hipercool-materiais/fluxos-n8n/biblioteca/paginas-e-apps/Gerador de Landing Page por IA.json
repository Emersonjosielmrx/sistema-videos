  {
   "parameters": {
    "jsCode": "const raw = $input.first().json;\nlet html = raw.output || raw.text || '';\n\n// Clean markdown if Gemini wrapped it\nhtml = html.replace(/^```html?\\s*\\n?/i, '').replace(/\\n?```\\s*$/i, '').trim();\n\n// Find HTML start if there's preamble text\nif (!html.startsWith('<')) {\n  const idx = html.indexOf('<!');\n  if (idx > -1) html = html.substring(idx);\n  else if (html.indexOf('<html') > -1) html = html.substring(html.indexOf('<html'));\n}\n\n// Generate unique page ID\nconst pageId = 'lp-' + Date.now().toString(36) + '-' + Math.random().toString(36).substring(2, 8);\n\n// Store in workflow static data\nconst staticData = $getWorkflowStaticData('global');\nif (!staticData.pages) staticData.pages = {};\nstaticData.pages[pageId] = {\n  html: html,\n  empresa: $('Recebe Dados POST').first().json.body.empresa || 'Empresa',\n  createdAt: new Date().toISOString()\n};\n\n// Limit stored pages to last 50\nconst keys = Object.keys(staticData.pages);\nif (keys.length > 50) {\n  const sorted = keys.sort((a, b) => {\n    const ta = staticData.pages[a].createdAt || '';\n    const tb = staticData.pages[b].createdAt || '';\n    return ta.localeCompare(tb);\n  });\n  for (let i = 0; i < sorted.length - 50; i++) {\n    delete staticData.pages[sorted[i]];\n  }\n}\n\nconst viewUrl = 'https://n8n6.inovareinteligenciaartificial.com/webhook/landing-page-view?id=' + pageId;\n\nreturn [{ json: { pageId, viewUrl, url: viewUrl, success: true } }];"
