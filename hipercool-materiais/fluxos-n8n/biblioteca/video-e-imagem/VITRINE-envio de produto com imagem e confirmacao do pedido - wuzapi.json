    "query": "-- Criar tabela de produtos\nCREATE TABLE IF NOT EXISTS infos_produtos (\n    id SERIAL PRIMARY KEY,\n    nome VARCHAR(255) NOT NULL,\n    descricao TEXT,\n    preco NUMERIC(10,2),\n    estoque INTEGER,\n    ativo BOOLEAN DEFAULT true,\n    criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    empresa TEXT\n);\n\n-- Criar tabela de imagens\nCREATE TABLE IF NOT EXISTS imagens_produtos (\n    id SERIAL PRIMARY KEY,\n    produto_id INTEGER NOT NULL,\n    url_imagem TEXT NOT NULL,\n    principal BOOLEAN DEFAULT false,\n    criado_em TIMESTAMP DEFAULT CURRENT_TIMESTAMP,\n    CONSTRAINT fk_produto \n        FOREIGN KEY (produto_id) \n        REFERENCES infos_produtos2(id) \n        ON DELETE CASCADE\n);\n\n-- Inserir produtos\nINSERT INTO infos_produtos (id, nome, descricao, preco, estoque, ativo, criado_em, empresa) VALUES\n(1, 'Camisa Social', 'Camisa social masculina manga longa', 129.90, 25, true, '2026-03-11 00:45:58.525407', 'e-commerce'),\n(2, 'Calça Jeans', 'Calça jeans masculina azul', 189.90, 15, true, '2026-03-11 00:45:58.525407', 'e-commerce'),\n(3, 'Tênis Casual', 'Tênis confortável para uso diário', 249.90, 10, true, '2026-03-11 00:45:58.525407', 'e-commerce'),\n(4, 'Toyota Corolla XEI 2022', 'Sedan automático, motor 2.0 flex', 129900.00, 3, true, '2026-03-13 00:33:48.650291', 'AutoPrime Veículos'),\n(5, 'Volkswagen T-Cross Comfortline 2023', 'SUV compacto 1.0 TSI turbo', 139500.00, 2, true, '2026-03-13 00:33:48.650291', 'AutoPrime Veículos'),\n(6, 'Chevrolet Onix Premier 2021', 'Hatch completo 1.0 turbo', 89900.00, 4, true, '2026-03-13 00:33:48.650291', 'AutoPrime Veículos'),\n(7, 'Honda Civic Touring 2020', 'Sedan premium 1.5 turbo', 134900.00, 1, true, '2026-03-13 00:33:48.650291', 'AutoPrime Veículos'),\n(8, 'Casa 3 Quartos com Piscina', 'Casa ampla com piscina', 420000.00, 1, true, '2026-03-13 00:34:38.604308', 'Imobiliária Horizonte'),\n(9, 'Apartamento Centro 2 Quartos', 'Apartamento moderno', 280000.00, 1, true, '2026-03-13 00:34:38.604308', 'Imobiliária Horizonte'),\n(10, 'Terreno Residencial 360m²', 'Terreno plano', 95000.00, 5, true, '2026-03-13 00:34:38.604308', 'Imobiliária Horizonte'),\n(11, 'Cobertura Duplex Vista Mar', 'Cobertura de luxo', 1250000.00, 1, true, '2026-03-13 00:34:38.604308', 'Imobiliária Horizonte');\n\n-- Inserir imagens\nINSERT INTO imagens_produtos (id, produto_id, url_imagem, principal, criado_em) VALUES\n(1, 1, 'https://img.ibxk.com.br/materias/5866/21577.jpg', true, '2026-03-11 00:46:50.981863'),\n(2, 1, 'https://img.freepik.com/fotos-gratis/arara.jpg', false, '2026-03-11 00:46:50.981863'),\n(3, 2, 'https://site.com/imagens/calca1.jpg', true, '2026-03-11 00:46:50.981863'),\n(4, 2, 'https://site.com/imagens/calca2.jpg', false, '2026-03-11 00:46:50.981863'),\n(5, 3, 'https://img.freepik.com/icone-tenis.jpg', true, '2026-03-11 00:46:50.981863'),\n(6, 1, 'https://upload.wikimedia.org/toyota.jpg', true, '2026-03-13 00:37:59.77618'),\n(7, 2, 'https://upload.wikimedia.org/tcross.jpg', true, '2026-03-13 00:37:59.77618'),\n(8, 3, 'https://images.unsplash.com/photo-1', true, '2026-03-13 00:37:59.77618'),\n(9, 4, 'https://images.unsplash.com/photo-2', true, '2026-03-13 00:37:59.77618'),\n(10, 5, 'https://images.unsplash.com/photo-3', true, '2026-03-13 00:38:47.652512'),\n(11, 6, 'https://images.unsplash.com/photo-4', true, '2026-03-13 00:38:47.652512'),\n(12, 7, 'https://images.unsplash.com/photo-5', true, '2026-03-13 00:38:47.652512'),\n(13, 8, 'https://images.unsplash.com/photo-6', true, '2026-03-13 00:38:47.652512');",
