  {
   "parameters": {
    "html": "<!DOCTYPE html>\n<html lang=\"pt-br\">\n<head>\n    <meta charset=\"UTF-8\">\n    <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n    <title>Admin - Vitrine IA</title>\n    <script src=\"https://cdn.tailwindcss.com\"></script>\n    <link rel=\"stylesheet\" href=\"https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css\">\n    <style>\n        .modal { transition: opacity 0.25s ease; }\n        body.modal-active { overflow-x: hidden; overflow-y: visible !important; }\n    </style>\n</head>\n<body class=\"bg-gray-100 min-h-screen font-sans\">\n\n    <header class=\"bg-slate-800 text-white shadow-md p-4\">\n        <div class=\"container mx-auto flex justify-between items-center\">\n            <div class=\"flex items-center gap-3\">\n                <div class=\"bg-indigo-500 p-2 rounded-lg\"><i class=\"fas fa-store\"></i></div>\n                <h1 class=\"text-xl font-bold tracking-tight\">PromovaWeb <span class=\"font-light opacity-50 text-sm\">| Inventory Control</span></h1>\n            </div>\n            <button onclick=\"toggleModal('modal-produto')\" class=\"bg-indigo-600 hover:bg-indigo-700 px-4 py-2 rounded-lg text-sm font-bold transition flex items-center gap-2\">\n                <i class=\"fas fa-plus\"></i> Novo Produto\n            </button>\n        </div>\n    </header>\n\n    <main class=\"container mx-auto py-8 px-4\">\n        \n        <div class=\"grid grid-cols-1 md:grid-cols-3 gap-6 mb-8\">\n            <div class=\"bg-white p-6 rounded-xl shadow-sm border-l-4 border-indigo-500\">\n                <p class=\"text-gray-500 text-sm font-medium uppercase\">Total de Produtos</p>\n                <h3 class=\"text-3xl font-bold text-gray-800\" id=\"stat-total\">0</h3>\n            </div>\n            <div class=\"bg-white p-6 rounded-xl shadow-sm border-l-4 border-green-500\">\n                <p class=\"text-gray-500 text-sm font-medium uppercase\">Ativos no Agente</p>\n                <h3 class=\"text-3xl font-bold text-gray-800\" id=\"stat-ativos\">0</h3>\n            </div>\n            <div class=\"bg-white p-6 rounded-xl shadow-sm border-l-4 border-amber-500\">\n                <p class=\"text-gray-500 text-sm font-medium uppercase\">Empresas Conectadas</p>\n                <h3 class=\"text-3xl font-bold text-gray-800\">3</h3>\n            </div>\n        </div>\n\n        <div class=\"bg-white rounded-xl shadow-sm overflow-hidden border border-gray-200\">\n            <div class=\"p-5 border-b border-gray-100 flex justify-between items-center bg-gray-50\">\n                <h2 class=\"font-bold text-gray-700 uppercase text-sm tracking-widest\">Lista de Inventário</h2>\n                <div class=\"relative\">\n                    <input type=\"text\" placeholder=\"Buscar produto...\" class=\"pl-10 pr-4 py-2 border rounded-lg text-sm focus:ring-2 focus:ring-indigo-500 outline-none\">\n                    <i class=\"fas fa-search absolute left-3 top-3 text-gray-400 text-xs\"></i>\n                </div>\n            </div>\n            <div class=\"overflow-x-auto\">\n                <table class=\"w-full text-left border-collapse\">\n                    <thead>\n                        <tr class=\"text-xs uppercase text-gray-400 bg-gray-50\">\n                            <th class=\"p-4 font-semibold\">ID</th>\n                            <th class=\"p-4 font-semibold\">Produto</th>\n                            <th class=\"p-4 font-semibold\">Empresa</th>\n                            <th class=\"p-4 font-semibold\">Preço</th>\n                            <th class=\"p-4 font-semibold\">Estoque</th>\n                            <th class=\"p-4 font-semibold\">Status</th>\n                            <th class=\"p-4 font-semibold text-center\">Ações</th>\n                        </tr>\n                    </thead>\n                    <tbody id=\"lista-produtos\" class=\"divide-y divide-gray-100 text-gray-700\">\n                        </tbody>\n                </table>\n            </div>\n        </div>\n    </main>\n\n    <div id=\"modal-produto\" class=\"modal opacity-0 pointer-events-none fixed w-full h-full top-0 left-0 flex items-center justify-center z-50\">\n        <div class=\"modal-overlay absolute w-full h-full bg-gray-900 opacity-50\"></div>\n        <div class=\"modal-container bg-white w-11/12 md:max-w-md mx-auto rounded-xl shadow-2xl z-50 overflow-y-auto\">\n            <div class=\"p-6\">\n                <div class=\"flex justify-between items-center pb-3\">\n                    <p class=\"text-2xl font-bold text-gray-800\" id=\"modal-title\">Novo Produto</p>\n                    <button onclick=\"toggleModal('modal-produto')\" class=\"text-gray-400 hover:text-gray-600 transition\">\n                        <i class=\"fas fa-times\"></i>\n                    </button>\n                </div>\n                \n                <form id=\"productForm\" class=\"space-y-4\">\n                    <input type=\"hidden\" id=\"prod-id\">\n                    <div>\n                        <label class=\"block text-xs font-bold uppercase text-gray-500 mb-1\">Nome</label>\n                        <input type=\"text\" id=\"prod-nome\" required class=\"w-full p-2.5 border rounded-lg focus:ring-2 focus:ring-indigo-500 outline-none\">\n                    </div>\n                    <div>\n                        <label class=\"block text-xs font-bold uppercase text-gray-500 mb-1\">Empresa</label>\n                        <select id=\"prod-empresa\" class=\"w-full p-2.5 border rounded-lg outline-none\">\n                            <option value=\"Imobiliária Horizonte\">Imobiliária Horizonte</option>\n                            <option value=\"AutoPrime Veículos\">AutoPrime Veículos</option>\n                            <option value=\"e-commerce\">E-commerce</option>\n                        </select>\n                    </div>\n                    <div class=\"grid grid-cols-2 gap-4\">\n                        <div>\n                            <label class=\"block text-xs font-bold uppercase text-gray-500 mb-1\">Preço (R$)</label>\n                            <input type=\"number\" step=\"0.01\" id=\"prod-preco\" required class=\"w-full p-2.5 border rounded-lg outline-none\">\n                        </div>\n                        <div>\n                            <label class=\"block text-xs font-bold uppercase text-gray-500 mb-1\">Estoque</label>\n                            <input type=\"number\" id=\"prod-estoque\" required class=\"w-full p-2.5 border rounded-lg outline-none\">\n                        </div>\n                    </div>\n                    <div>\n                        <label class=\"block text-xs font-bold uppercase text-gray-500 mb-1\">Descrição</label>\n                        <textarea id=\"prod-desc\" rows=\"3\" class=\"w-full p-2.5 border rounded-lg outline-none\"></textarea>\n                    </div>\n                    <div class=\"flex items-center gap-2 py-2\">\n                        <input type=\"checkbox\" id=\"prod-ativo\" checked class=\"w-4 h-4 text-indigo-600\">\n                        <label class=\"text-sm font-medium text-gray-700\">Disponível para o Agente</label>\n                    </div>\n                    \n                    <button type=\"submit\" class=\"w-full bg-indigo-600 text-white py-3 rounded-lg font-bold hover:bg-indigo-700 transition shadow-lg\">\n                        Salvar Alterações\n                    </button>\n                </form>\n            </div>\n        </div>\n    </div>\n\n    <script>\n        // Dados Fictícios (Baseado no seu SQL) caso o n8n não retorne nada\n        const fallbackData = [\n            { id: 4, nome: 'Toyota Corolla XEI 2022', empresa: 'AutoPrime Veículos', preco: 129900.00, estoque: 3, ativo: true, descricao: 'Sedan automático' },\n            { id: 8, nome: 'Casa 3 Quartos com Piscina', empresa: 'Imobiliária Horizonte', preco: 420000.00, estoque: 1, ativo: true, descricao: 'Casa ampla com piscina' },\n            { id: 1, nome: 'Camisa Social', empresa: 'e-commerce', preco: 129.90, estoque: 25, ativo: true, descricao: 'Camisa masculina manga longa' }\n        ];\n\n        let produtosAtuais = [];\n\n        // Inicialização\n        window.onload = () => {\n            carregarProdutos();\n        };\n\n        async function carregarProdutos() {\n            // Aqui você faria o fetch para o seu webhook de \"Listar\" do n8n\n            // const res = await fetch('SUA_URL_WEBHOOK_GET');\n            // const data = await res.json();\n            \n            // Simulando que se o array vier vazio, usamos o fictício\n            produtosAtuais = fallbackData; \n            renderizarTabela();\n        }\n\n        function renderizarTabela() {\n            const tbody = document.getElementById('lista-produtos');\n            tbody.innerHTML = '';\n\n            produtosAtuais.forEach(p => {\n                const tr = document.createElement('tr');\n                tr.className = \"hover:bg-gray-50 transition border-b border-gray-100\";\n                tr.innerHTML = `\n                    <td class=\"p-4 text-xs font-mono text-gray-400\">#${p.id}</td>\n                    <td class=\"p-4\">\n                        <div class=\"font-bold text-gray-800\">${p.nome}</div>\n                        <div class=\"text-xs text-gray-400 truncate w-48\">${p.descricao}</div>\n                    </td>\n                    <td class=\"p-4 text-sm\">${p.empresa}</td>\n                    <td class=\"p-4 font-bold text-indigo-600\">R$ ${p.preco.toLocaleString('pt-BR')}</td>\n                    <td class=\"p-4 text-sm text-center\">${p.estoque}</td>\n                    <td class=\"p-4\">\n                        <span class=\"px-2 py-1 rounded-full text-[10px] font-bold uppercase ${p.ativo ? 'bg-green-100 text-green-700' : 'bg-red-100 text-red-700'}\">\n                            ${p.ativo ? 'Ativo' : 'Inativo'}\n                        </span>\n                    </td>\n                    <td class=\"p-4 text-center\">\n                        <button onclick=\"editarProduto(${p.id})\" class=\"text-indigo-600 hover:text-indigo-900 p-2 rounded-lg hover:bg-indigo-50\">\n                            <i class=\"fas fa-edit\"></i>\n                        </button>\n                        <button onclick=\"deletarProduto(${p.id})\" class=\"text-red-400 hover:text-red-600 p-2\">\n                            <i class=\"fas fa-trash\"></i>\n                        </button>\n                    </td>\n                `;\n                tbody.appendChild(tr);\n            });\n\n            // Atualiza Stats\n            document.getElementById('stat-total').innerText = produtosAtuais.length;\n            document.getElementById('stat-ativos').innerText = produtosAtuais.filter(p => p.ativo).length;\n        }\n\n        function editarProduto(id) {\n            const p = produtosAtuais.find(item => item.id === id);\n            if (!p) return;\n\n            document.getElementById('modal-title').innerText = \"Editar Produto\";\n            document.getElementById('prod-id').value = p.id;\n            document.getElementById('prod-nome').value = p.nome;\n            document.getElementById('prod-empresa').value = p.empresa;\n            document.getElementById('prod-preco').value = p.preco;\n            document.getElementById('prod-estoque').value = p.estoque;\n            document.getElementById('prod-desc').value = p.descricao;\n            document.getElementById('prod-ativo').checked = p.ativo;\n\n            toggleModal('modal-produto');\n        }\n\n        function toggleModal(modalID) {\n            const modal = document.getElementById(modalID);\n            modal.classList.toggle('opacity-0');\n            modal.classList.toggle('pointer-events-none');\n            document.body.classList.toggle('modal-active');\n            \n            if (modal.classList.contains('opacity-0')) {\n                document.getElementById('productForm').reset();\n                document.getElementById('prod-id').value = '';\n                document.getElementById('modal-title').innerText = \"Novo Produto\";\n            }\n        }\n\n        document.getElementById('productForm').onsubmit = async (e) => {\n            e.preventDefault();\n            \n            const prodId = document.getElementById('prod-id').value;\n            const payload = {\n                id: prodId || Date.now(), // Simula ID se for novo\n                nome: document.getElementById('prod-nome').value,\n                empresa: document.getElementById('prod-empresa').value,\n                preco: parseFloat(document.getElementById('prod-preco').value),\n                estoque: parseInt(document.getElementById('prod-estoque').value),\n                descricao: document.getElementById('prod-desc').value,\n                ativo: document.getElementById('prod-ativo').checked\n            };\n\n            // Lógica de atualização local para exemplo\n            if (prodId) {\n                const index = produtosAtuais.findIndex(p => p.id == prodId);\n                produtosAtuais[index] = payload;\n            } else {\n                produtosAtuais.push(payload);\n            }\n\n            // AQUI VOCÊ ENVIA PARA O n8n (POST ou PUT)\n            console.log(\"Enviando para n8n:\", payload);\n            \n            renderizarTabela();\n            toggleModal('modal-produto');\n            alert(\"Banco de dados atualizado com sucesso!\");\n        };\n\n        function deletarProduto(id) {\n            if(confirm(\"Deseja remover este produto do catálogo do Agente?\")) {\n                produtosAtuais = produtosAtuais.filter(p => p.id !== id);\n                renderizarTabela();\n            }\n        }\n    </script>\n</body>\n</html>"
   },
