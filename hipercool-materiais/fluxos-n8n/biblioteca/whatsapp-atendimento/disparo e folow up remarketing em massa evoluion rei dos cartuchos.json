   "id": "4755162e-9cf8-4f24-83a3-724a8fb6dce6",
   "name": "Loop Over Items"
  },
  {
   "parameters": {
    "jsCode": "// Código para N8N - Code Node\n// Filtra apenas instâncias com connectionStatus \"open\"\n// Exclui ownerJid que contém: 984698653, 984074247, 985685106\n// e extrai os campos: name, ownerJid e token\n\nconst inputData = $input.all();\nconst result = [];\n\n// Lista de números a serem excluídos (apenas os dígitos relevantes)\nconst excludedNumbers = ['84698653', '84074247', '85685106'];\n\n// Processa cada item de entrada\ninputData.forEach(item => {\n  const data = item.json;\n  \n  // Verifica se é um array ou objeto único\n  const items = Array.isArray(data) ? data : [data];\n  \n  // Filtra e mapeia os dados\n  items.forEach(instance => {\n    // Verifica se o connectionStatus é \"open\"\n    if (instance.connectionStatus === \"open\") {\n      // Verifica se o ownerJid NÃO contém nenhum dos números excluídos\n      const shouldExclude = excludedNumbers.some(num => \n        instance.ownerJid && instance.ownerJid.includes(num)\n      );\n      \n      // Se não deve excluir, adiciona ao resultado\n      if (!shouldExclude) {\n        result.push({\n          name: instance.name,\n          ownerJid: instance.ownerJid,\n          token: instance.token\n        });\n      }\n    }\n  });\n});\n\n// Retorna os dados filtrados\nreturn result.map(item => ({ json: item }));"
   },
   "type": "n8n-nodes-base.code",
   "typeVersion": 2,
   "position": [
    11440,
    2128
   ],
